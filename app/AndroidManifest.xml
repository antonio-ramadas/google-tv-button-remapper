<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.antonio.tvremap" android:versionCode="3" android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <package android:name="com.android.systemui" />
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_TV_OEM_LINK" /></intent>
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <application android:label="@string/app_name" android:theme="@style/AppTheme" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:enableOnBackInvokedCallback="true">
        <activity android:name=".MainActivity" android:label="@string/app_name" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".RemapService" android:exported="true" android:directBootAware="true" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remap_service" />
        </service>
    </application>
</manifest>
