<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Remaps, consent, and pause state belong to this TV, including before unlock. -->
    <cloud-backup>
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="device_sharedpref" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
